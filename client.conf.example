# iPhone WireGuard tunnel config — create one per device.
# Import into the WireGuard iOS app manually or via QR code.
# Address: assign each device a unique IP (10.13.0.2, 10.13.0.3, etc.)

[Interface]
PrivateKey = <device private key — generated by the WireGuard app>
Address = 10.13.0.2/32
DNS = 1.1.1.1

[Peer]
PublicKey = <contents of /etc/wireguard/server_public.key>
AllowedIPs = 0.0.0.0/0
Endpoint = yourname.duckdns.org:<your chosen UDP port>
