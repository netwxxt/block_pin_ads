[Unit]
Description=mitmproxy Pinterest ad stripper
After=network.target wg-quick@wg0.service

[Service]
Type=simple
Environment=HOME=/opt/mitm-venv
ExecStart=/opt/mitm-venv/bin/mitmdump --mode transparent -s /opt/pinterest-adblock/strip_ads.py --listen-host 0.0.0.0 --listen-port 8080 --set confdir=/opt/mitm-venv/.mitmproxy
Restart=on-failure
User=mitmproxy
Group=mitmproxy
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
